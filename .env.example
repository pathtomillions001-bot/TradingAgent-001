# ============================================================================
# TradingAgent-001 — Local Windows 10 + MT5 + Zero-Fee Ollama Configuration
# ============================================================================

# Execution Mode: "paper" (local MT5-fidelity simulator), "mt5_demo", or "mt5_live"
TRADING_MODE=paper

# MetaTrader 5 Terminal Credentials (Windows 10 Native IPC)
# Leave MT5_LOGIN / MT5_PASSWORD / MT5_SERVER blank if MT5 is already open & logged in on your desktop!
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=
MT5_MAGIC_NUMBER=2026001

# 100% Zero-Fee Local LLM Engine (Ollama running on http://127.0.0.1:11434)
# Tuned for Windows 10 with 16GB RAM:
#   - Fast Single-Model Setup (~2.5GB RAM): qwen3:4b for both quick & deep roles
#   - Dual-Model Setup (~5.0GB RAM): qwen3:4b + qwen3:8b (auto-falls back to installed model)
#   - Or set LLM_ENABLED=false for pure deterministic sub-millisecond quant mode
LLM_ENABLED=true
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_QUICK_MODEL=qwen3:4b
OLLAMA_DEEP_MODEL=qwen3:4b
LLM_TIMEOUT_SECONDS=25

# Optional OpenAI-compatible endpoint (LM Studio, vLLM, or free-tier Groq/OpenRouter)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=

# Hard Deterministic Risk Mandate (AI CANNOT override these limits)
# Note: All symbols size dynamically from live MT5 tick_value at RISK_PER_TRADE_PCT (0.75%).
# On small accounts (<$1,000), Tier-1 Gold (XAUUSD) is permitted to use broker 0.01 min lot
# up to GOLD_MIN_LOT_MAX_RISK_PCT (3.25%), with automatic USD correlation lock until Break-Even.
RISK_PER_TRADE_PCT=0.75
MAX_MIN_LOT_RISK_PCT=1.25
GOLD_MIN_LOT_MAX_RISK_PCT=3.25
MAX_DAILY_LOSS_PCT=2.50
MAX_TOTAL_DRAWDOWN_PCT=6.00
MAX_OPEN_POSITIONS=2
MAX_GOLD_POSITIONS=1
MAX_NET_USD_RISK_PCT=1.25
MIN_RISK_REWARD_RATIO=1.80
COOLDOWN_MINUTES_PER_SYMBOL=15

# Local Dashboard Server & Built-In Autonomous Loop
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
AUTOPILOT_ENABLED=false
AUTOPILOT_INTERVAL_SECONDS=15
